import { ScrollView, TextEdit, Palette, AboutSlint } from "std-widgets.slint";

export struct NoteRow {
    id: int,
    stable-id: string,
    number: int,
    kind-label: string,
    text: string,
    summary: string,
    editor-height: float,
    selected: bool,
    detail: string,
}

export struct Mark {
    id: int,
    number: int,
    x: float,
    y: float,
    w: float,
    h: float,
    is-point: bool,
    selected: bool,
    is-block: bool,
    source-x: float,
    source-y: float,
    source-w: float,
    source-h: float,
}

struct NoteViewState {
    token: int,
    index: int,
    top: length,
    bottom: length,
    focused: bool,
    active: bool,
    composing: bool,
    header-x: length,
    header-y: length,
    delete-x: length,
    delete-y: length,
    editor-x: length,
    editor-y: length,
}

// 共享按钮：鼠标操作不抢走编辑焦点，Tab 和辅助技术仍可直接到达。
component ActionButton inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <length> icon-size: 17px;
    in property <bool> icon-only: false;
    in property <string> shortcut;
    in property <bool> primary: false;
    in property <bool> quiet: false;
    in property <bool> enabled: true;
    in property <bool> destructive: false;
    in property <bool> focus-ring: false;
    in property <bool> blocks-scroll: false;
    in property <length> font-size: 12px;
    out property <bool> hovered: hit.has-hover;
    out property <bool> focused: keys.has-focus;
    callback clicked();
    function activate() { if root.enabled { root.clicked(); } }
    property <color> foreground: !root.enabled ? #929cac : root.primary ? #ffffff
        : root.destructive ? (root.icon-only && !hit.has-hover ? #8994a5 : #b94c56) : #3f4b5d;
    property <string> tip-text: root.shortcut == "" ? root.label : root.label + " · " + root.shortcut;
    height: 36px;
    min-width: root.icon-only ? root.icon-size + 17px : content.min-width;
    preferred-width: root.icon-only ? 36px : content.preferred-width;
    horizontal-stretch: 0;
    border-radius: 7px;
    border-width: root.focus-ring || keys.has-focus ? 2px : (root.quiet ? 0px : 1px);
    border-color: root.focus-ring || keys.has-focus ? #7085eb : !root.enabled ? #e0e5ed
        : root.primary ? #4562e5 : hit.has-hover ? #cbd3df : #dfe4ec;
    background: !root.enabled ? (root.quiet ? transparent : #f7f8fa)
        : root.primary ? (hit.pressed ? #2e49c6 : hit.has-hover ? #3653d7 : #4562e5)
        : root.destructive && hit.has-hover ? #f4e9ed
        : hit.pressed ? #edf1f8 : hit.has-hover ? #f2f4f8 : root.quiet ? transparent : #ffffff;
    animate background, border-color { duration: root.enabled ? 100ms : 0ms; }
    forward-focus: keys;
    accessible-role: button;
    accessible-label: root.label;
    accessible-description: root.shortcut;
    accessible-enabled: root.enabled;
    accessible-action-default => { root.activate(); }
    content := HorizontalLayout {
        padding-left: root.icon-only ? 0px : 13px;
        padding-right: root.icon-only ? 0px : 13px;
        spacing: 7px;
        alignment: center;
        if root.icon.width > 0 : Image {
            y: (parent.height - self.height) / 2;
            width: root.icon-size; height: root.icon-size;
            source: root.icon; colorize: root.foreground;
            image-fit: contain;
        }
        if !root.icon-only : Text {
            text: root.label; color: root.foreground;
            font-size: root.font-size; font-weight: 500;
            vertical-alignment: center;
        }
    }
    hit := TouchArea {
        enabled: root.enabled; clicked => { root.activate(); }
        scroll-event(event) => { return root.blocks-scroll ? accept : reject; }
    }
    keys := FocusScope {
        width: 0px; height: 0px; enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " { root.activate(); return accept; }
            return reject;
        }
    }
    Tooltip { text: @markdown("\{root.tip-text}"); }
}

component ToolButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <string> shortcut;
    in property <bool> active-state: false;
    in property <bool> enabled: true;
    callback clicked();
    width: 48px; height: 61px; border-radius: 8px;
    background: root.active-state ? #e9edff : (hit.has-hover && root.enabled ? #f3f5fa : transparent);
    border-width: keys.has-focus ? 2px : 0px; border-color: #7085eb;
    animate background { duration: 120ms; }
    forward-focus: keys;
    accessible-role: button;
    accessible-label: root.label;
    accessible-description: root.shortcut;
    accessible-enabled: root.enabled;
    accessible-checkable: true;
    accessible-checked: root.active-state;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    Image {
        x: 13px; y: 9px; width: 22px; height: 22px;
        source: root.icon; image-fit: contain;
        colorize: !root.enabled ? #a6afbd : root.active-state ? #3e5ad6 : #697487;
    }
    Text {
        y: 37px; width: parent.width; height: 16px;
        text: root.label; font-size: 10px;
        color: !root.enabled ? #a6afbd : root.active-state ? #3e5ad6 : #697487;
        font-weight: root.active-state ? 600 : 400; horizontal-alignment: center;
    }
    hit := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
    keys := FocusScope {
        width: 0px; height: 0px; enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " { root.clicked(); return accept; }
            return reject;
        }
    }
    Tooltip { text: @markdown("\{root.label} · \{root.shortcut}"); }
}

// 原生 TextInput 保留输入法、选区与文字键盘行为；外框和滚动由本组件统一。
component NoteEditor inherits Rectangle {
    in-out property <string> text;
    in property <bool> enabled: true;
    out property <bool> has-focus: input.has-focus;
    out property <bool> composing: input.preedit-text != "";
    callback edited(string);
    callback key-pressed(KeyEvent) -> EventResult;
    forward-focus: input;
    border-radius: 7px; background: #ffffff;
    border-width: input.has-focus ? 2px : 1px;
    border-color: input.has-focus ? #7085eb : #dfe4ed;
    animate border-color { duration: 100ms; }
    ContextMenuArea {
        width: parent.width; height: parent.height; enabled: root.enabled;
        Menu {
            MenuItem { title: "剪切"; activated => { input.cut(); } }
            MenuItem { title: "复制"; activated => { input.copy(); } }
            MenuItem { title: "粘贴"; activated => { input.paste(); } }
            MenuItem { title: "全选"; activated => { input.select-all(); } }
        }
        scroll := ScrollView {
            x: 10px; y: 10px; width: parent.width - 20px; height: parent.height - 20px;
            content-width: self.visible-width;
            content-height: max(self.visible-height, input.preferred-height);
            input := TextInput {
                text <=> root.text; enabled: root.enabled;
                single-line: false; wrap: word-wrap; font-size: 12px; color: #344055;
                selection-background-color: #dce4ff; selection-foreground-color: #26375a;
                page-height: scroll.visible-height;
                accessible-role: text-input;
                accessible-label: "批注意见";
                accessible-placeholder-text: "写下这处的修改意见…";
                edited => { root.edited(self.text); }
                key-pressed(event) => {
                    if self.preedit-text != "" { return reject; }
                    root.key-pressed(event)
                }
                cursor-position-changed(cursor) => {
                    let top = cursor.y + scroll.content-y;
                    let desired = top < 0px ? -cursor.y
                        : top > scroll.visible-height - 18px ? scroll.visible-height - 18px - cursor.y : scroll.content-y;
                    scroll.content-y = max(scroll.visible-height - scroll.content-height, min(0px, desired));
                }
            }
        }
        if root.text == "" && !root.composing : Text {
            x: 10px; y: 10px; width: parent.width - 20px;
            text: "写下这处的修改意见…"; font-size: 12px; color: #aeb6c2;
        }
    }
}

component WindowButton inherits Rectangle {
    in property <int> kind: 0;
    in property <bool> restored: false;
    in property <string> description;
    callback clicked();
    width: 38px; height: 32px; border-radius: 7px;
    background: hit.has-hover ? (root.kind == 2 ? #e45162 : #e9ecf4) : transparent;
    accessible-role: button;
    accessible-label: root.description;
    if root.kind == 0 : Rectangle { x: 13px; y: 16px; width: 12px; height: 1.4px; background: #586174; }
    if root.kind == 1 && !root.restored : Rectangle { x: 13px; y: 10px; width: 12px; height: 12px; border-width: 1.3px; border-color: #586174; border-radius: 2px; background: transparent; }
    if root.kind == 1 && root.restored : Rectangle {
        x: 14px; y: 9px; width: 11px; height: 11px; border-width: 1.2px; border-color: #586174; border-radius: 1px; background: transparent;
        Rectangle { x: -3px; y: 3px; width: 11px; height: 11px; border-width: 1.2px; border-color: #586174; border-radius: 1px; background: hit.has-hover ? #e9ecf4 : #f8f9fc; }
    }
    if root.kind == 2 : Path { x: 13px; y: 10px; width: 12px; height: 12px; commands: "M 0 0 L 12 12 M 12 0 L 0 12"; stroke: hit.has-hover ? #ffffff : #586174; stroke-width: 1.5px; fill: transparent; }
    if root.kind == 3 : Text { x: 0px; y: 0px; width: parent.width; height: parent.height; text: "···"; color: #687386; font-size: 19px; horizontal-alignment: center; vertical-alignment: center; }
    hit := TouchArea { clicked => { root.clicked(); } }
}

export component AppWindow inherits Window {
    title: root.loaded ? root.image-name + " — Image Feedback" : "Image Feedback";
    preferred-width: 1280px;
    preferred-height: 848px;
    min-width: 1000px;
    min-height: 688px;
    in property <bool> native-chrome: false;
    property <length> titlebar-height: root.native-chrome ? 0px : 44px;
    no-frame: !root.native-chrome;
    resize-border-width: root.native-chrome ? 0px : 6px;
    icon: @image-url("../assets/app-icon.png");
    background: #f5f6f8;
    default-font-size: 13px;
    forward-focus: canvasKeys;
    init => { Palette.color-scheme = ColorScheme.light; }
    in-out property <bool> space-held: false;
    in-out property <bool> shift-held: false;
    callback canvas-command(string);
    changed space-held => { if root.space-held { root.canvas-command("leave"); } }
    changed shift-held => { if root.shift-held { root.canvas-command("leave"); } }

    in property <image> source-image;
    in property <bool> loaded: false;
    in property <string> image-name: "尚未导入图片";
    in property <string> status-text: "准备就绪";
    in property <bool> can-undo: false;
    in property <bool> can-redo: false;
    in property <int> tool: 0;
    in property <bool> can-reset-view: false;
    in property <bool> touchpad-scroll: false;
    in property <bool> native-touchpad-ready: false;
    in property <int> note-count: 0;
    in property <[NoteRow]> notes;
    in property <int> active-note-token: 0;
    in property <[Mark]> marks;
    in property <float> canvas-x: 0;
    in property <float> canvas-y: 0;
    in property <float> canvas-w: 0;
    in property <float> canvas-h: 0;
    in property <float> preview-x: 0;
    in property <float> preview-y: 0;
    in property <float> preview-w: 0;
    in property <float> preview-h: 0;
    in property <bool> preview-visible: false;
    in property <bool> busy: false;
    in property <bool> smart-enabled: true;
    in property <string> smart-status: "智能预选 · 载入图片后准备";
    in property <bool> hover-visible: false;
    in property <image> hover-image;
    in property <float> hover-x;
    in property <float> hover-y;
    in property <float> hover-w;
    in property <float> hover-h;
    callback toggle-smart();
    out property <float> viewport-width: canvasClip.width / 1px;
    out property <float> viewport-height: canvasClip.height / 1px;
    out property <float> canvas-window-x: canvasTouch.absolute-position.x / 1px;
    out property <float> canvas-window-y: canvasTouch.absolute-position.y / 1px;
    out property <float> copy-button-center-x: (copyFeedback.absolute-position.x + copyFeedback.width / 2) / 1px;
    out property <float> copy-button-center-y: (copyFeedback.absolute-position.y + copyFeedback.height / 2) / 1px;
    out property <float> new-button-center-x: (newWorkspace.absolute-position.x + newWorkspace.width / 2) / 1px;
    out property <float> new-button-center-y: (newWorkspace.absolute-position.y + newWorkspace.height / 2) / 1px;
    out property <float> close-button-center-x: (closeWindow.absolute-position.x + closeWindow.width / 2) / 1px;
    out property <float> close-button-center-y: (closeWindow.absolute-position.y + closeWindow.height / 2) / 1px;
    in property <bool> delivery-ready: false;
    out property <float> zoom-plus-center-x: (zoomPlus.absolute-position.x + zoomPlus.width / 2) / 1px;
    out property <float> zoom-plus-center-y: (zoomPlus.absolute-position.y + zoomPlus.height / 2) / 1px;
    out property <float> zoom-right-gap: (canvasClip.width - zoomControls.x - zoomControls.width) / 1px;
    out property <float> copy-button-right: (copyFeedback.absolute-position.x + copyFeedback.width) / 1px;
    out property <float> copy-button-top: copyFeedback.absolute-position.y / 1px;
    out property <float> toast-right: (toast.absolute-position.x + toast.width) / 1px;
    out property <float> toast-bottom: (toast.absolute-position.y + toast.height) / 1px;
    out property <float> reset-view-center-x: (zoomControls.absolute-position.x - 23px) / 1px;
    out property <float> reset-view-center-y: (zoomControls.absolute-position.y + 19px) / 1px;
    out property <float> note-scroll-y: noteScroll.content-y / 1px;
    out property <float> notes-viewport-height: noteScroll.visible-height / 1px;
    out property <float> active-note-top: root.has-active-note ? root.active-note-state.top / 1px : -1;
    out property <float> active-note-bottom: root.has-active-note ? root.active-note-state.bottom / 1px : -1;
    out property <bool> active-note-visible: root.has-active-note && !root.confirm-visible
        && root.active-note-top + root.note-scroll-y >= 0
        && root.active-note-bottom + root.note-scroll-y <= root.notes-viewport-height;
    out property <float> active-note-header-x: root.active-note-state.header-x / 1px;
    out property <float> active-note-header-y: root.active-note-state.header-y / 1px;
    out property <float> active-note-delete-x: root.active-note-state.delete-x / 1px;
    out property <float> active-note-delete-y: root.active-note-state.delete-y / 1px;
    out property <float> active-note-editor-x: root.active-note-state.editor-x / 1px;
    out property <float> active-note-editor-y: root.active-note-state.editor-y / 1px;
    out property <bool> text-composing: root.has-active-note && root.active-note-state.composing;
    out property <bool> active-editor-focused: root.has-active-note
        && root.active-note-state.focused && !root.confirm-visible && !root.busy;

    property <NoteViewState> active-note-state;
    property <bool> has-active-note: root.active-note-token > 0
        && root.active-note-state.token == root.active-note-token
        && root.active-note-state.index >= 0 && root.active-note-state.index < root.notes.length
        && root.notes[root.active-note-state.index].id == root.active-note-token
        && root.notes[root.active-note-state.index].selected;
    property <int> note-reveal-token: 0;
    property <int> note-reveal-request: 0;
    property <int> note-reveal-applied: 0;

    // Consume explicit requests only, never force a scroll on normal model sync.
    public function reveal-note(token: int) {
        if token > 0 && token == root.active-note-token && !root.confirm-visible {
            root.note-reveal-token = token;
            root.note-reveal-request += 1;
        }
    }

    function reveal-note-bounds(top: length, bottom: length) {
        let offset = noteScroll.content-y;
        let visible = noteScroll.visible-height;
        let target = top + offset < 8px ? 8px - top
            : (bottom + offset > visible - 8px ? visible - 8px - bottom : offset);
        noteScroll.content-y = max(min(0px, visible - noteScroll.content-height), min(0px, target));
    }
    changed notes-viewport-height => {
        if root.has-active-note && !root.confirm-visible { root.reveal-note(root.active-note-token); }
    }
    in property <bool> toast-visible: false;
    in property <bool> toast-success: true;
    in property <string> toast-title;
    in property <string> toast-message;
    in property <bool> copy-complete: false;
    callback dismiss-toast();
    callback resident-quit-requested();

    in property <bool> confirm-visible: false;
    in property <string> confirm-title;
    in property <string> confirm-description;
    in property <string> confirm-name;
    in property <string> confirm-primary-label: "确定";
    in property <string> confirm-cancel-label: "取消";
    in property <bool> confirm-show-cancel: true;
    in property <bool> confirm-destructive: false;
    in property <string> confirm-footnote: "";
    in-out property <int> confirm-choice: 2;
    out property <bool> confirm-has-focus: confirmKeys.has-focus;
    out property <float> confirm-cancel-x: (confirmCancel.absolute-position.x + confirmCancel.width / 2) / 1px;
    out property <float> confirm-cancel-y: (confirmCancel.absolute-position.y + confirmCancel.height / 2) / 1px;
    out property <float> confirm-primary-x: (confirmPrimary.absolute-position.x + confirmPrimary.width / 2) / 1px;
    out property <float> confirm-primary-y: (confirmPrimary.absolute-position.y + confirmPrimary.height / 2) / 1px;
    callback confirm-response(int);
    changed confirm-visible => {
        if root.confirm-visible {
            helpMenu.close();
            about.close();
            root.space-held = false;
            root.shift-held = false;
            root.confirm-choice = root.confirm-destructive && root.confirm-show-cancel ? 0 : 2;
            confirmKeys.focus();
        } else {
            if root.has-active-note { root.reveal-note(root.active-note-token); } else { canvasKeys.focus(); }
        }
    }

    callback clear-feedback();
    out property <bool> toolbar-fits: fileButtons.absolute-position.x + fileButtons.width <= historyButtons.absolute-position.x
        && historyButtons.absolute-position.x + historyButtons.width <= root.width - 20px;
    public function focus-copy() { copyFeedback.focus(); }
    out property <bool> copy-help-visible: (copyFeedback.hovered || copyFeedback.focused) && !root.confirm-visible && !root.toast-visible;
    out property <float> clear-feedback-center-x: (clearFeedback.absolute-position.x + clearFeedback.width / 2) / 1px;
    out property <float> clear-feedback-center-y: (clearFeedback.absolute-position.y + clearFeedback.height / 2) / 1px;
    public function focus-canvas() { canvasKeys.focus(); }
    callback new-workspace();
    callback import-image();
    callback paste-image();
    callback copy-feedback();
    callback copy-original-path();
    callback copy-portable-data();
    callback open-feedback-folder();
    callback add-global();
    callback load-example();
    callback undo();
    callback redo();
    callback choose-tool(int);
    callback fit-view();
    callback zoom-by(float);
    callback select-note(int);
    callback remove-note(int);
    callback note-edited(int, string);
    callback note-edit-finished(int);
    callback canvas-press(float, float, int);
    callback canvas-move(float, float);
    callback canvas-release(float, float);
    callback canvas-wheel(float, float, float, float, bool);
    public function canvas-accepts-scroll(x: float, y: float) -> bool {
        let local-x = x * 1px - canvasClip.absolute-position.x;
        let local-y = y * 1px - canvasClip.absolute-position.y;
        return root.loaded && !root.busy && !root.confirm-visible && !root.text-composing
            && local-x >= 0px && local-y >= 0px && local-x < canvasClip.width && local-y < canvasClip.height
            && !(local-x >= zoomControls.x - 42px && local-x <= zoomControls.x + zoomControls.width
                && local-y >= zoomControls.y && local-y <= zoomControls.y + zoomControls.height);
    }
    callback viewport-resized(float, float);

    changed viewport-width => {
        root.viewport-resized(root.viewport-width, root.viewport-height);
    }
    changed viewport-height => {
        root.viewport-resized(root.viewport-width, root.viewport-height);
    }

    // 编辑快捷键覆盖画布、工具栏和批注编辑器；Slint 在 macOS 将 Control 映射为 ⌘。
    appKeys := FocusScope {
        width: parent.width;
        height: parent.height;
        capture-key-pressed(event) => {
            if root.confirm-visible || root.busy || root.text-composing { return reject; }
            if event.modifiers.control && !event.modifiers.alt && !event.modifiers.meta {
                if event.text.to-lowercase() == "z" {
                    if event.modifiers.shift { root.redo(); } else { root.undo(); }
                    return accept;
                }
                if !event.modifiers.shift {
                    if event.text.to-lowercase() == "y" { root.redo(); return accept; }
                    if event.text.to-lowercase() == "n" { root.new-workspace(); return accept; }
                    if event.text.to-lowercase() == "o" { root.import-image(); return accept; }
                }
            }
            return reject;
        }
    helpMenu := PopupWindow {
        x: root.width - 230px; y: root.native-chrome ? 62px : 42px; width: 216px; height: 232px;
        Rectangle { x: 0px; y: 0px; width: parent.width; height: parent.height; border-radius: 9px; border-width: 1px; border-color: #dfe3ed; background: #ffffff;
            ActionButton { x: 7px; y: 8px; width: 182px; height: 40px; label: "复制原图路径"; quiet: true; enabled: root.loaded && !root.busy && !root.text-composing; clicked => { helpMenu.close(); root.copy-original-path(); } }
            ActionButton { x: 7px; y: 52px; width: 202px; height: 40px; label: "复制 Base64 便携数据"; quiet: true; enabled: root.loaded && !root.busy && !root.text-composing; clicked => { helpMenu.close(); root.copy-portable-data(); } }
            ActionButton { x: 7px; y: 96px; width: 202px; height: 40px; label: "打开最近图片快照"; quiet: true; enabled: root.delivery-ready && !root.busy; clicked => { helpMenu.close(); root.open-feedback-folder(); } }
            ActionButton { x: 7px; y: 140px; width: 202px; height: 40px; label: root.smart-enabled ? "智能预选：开" : "智能预选：关"; quiet: true; enabled: !root.busy && !root.text-composing; clicked => { helpMenu.close(); root.toggle-smart(); } }
            ActionButton { x: 7px; y: 184px; width: 202px; height: 40px; label: "关于图片反馈"; quiet: true; clicked => { helpMenu.close(); about.show(); } }
        }
    }
    about := PopupWindow {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        width: 430px;
        height: 285px;
        Rectangle { x: 0px; y: 0px; width: parent.width; height: parent.height; border-width: 1px; border-color: #dfe3e9; border-radius: 10px; background: #ffffff; }
        Text { x: 24px; y: 24px; width: 382px; height: 28px; text: "图片反馈 · Rust + Slint"; color: #253042; font-size: 20px; font-weight: 600; }
        Text { x: 24px; y: 65px; width: 382px; height: 40px; text: "本地处理，不内置模型调用。\n应用原创代码与智能选区移植遵循 MIT。"; color: #687386; font-size: 12px; }
        AboutSlint { x: 24px; y: 116px; width: 382px; height: 87px; }
        ActionButton { x: 316px; y: 223px; width: 90px; label: "关闭"; clicked => { about.close(); } }
    }

    // Frameless, application-drawn title bar. WindowMoveArea and resize-border-width
    // keep the operating system's drag/resize behavior without stock window chrome.
    Rectangle {
        visible: !root.native-chrome;
        x: 0px; y: 0px; width: parent.width; height: root.titlebar-height; background: #f8f9fc;
        WindowMoveArea {
            x: 0px; y: 0px; width: parent.width - 182px; height: 44px;
            TouchArea { double-clicked => { root.maximized = !root.maximized; } }
        }
        Image { x: 16px; y: 10px; width: 24px; height: 24px; source: @image-url("../assets/app-icon.png"); image-fit: contain; }
        Text { x: 49px; y: 12px; width: 130px; height: 22px; text: "图片反馈"; font-size: 13px; font-weight: 600; color: #344055; }
        Text { x: 190px; y: 12px; width: parent.width - 392px; height: 21px; visible: root.loaded; text: root.image-name; font-size: 12px; color: #838b9d; horizontal-alignment: center; overflow: elide; }
        WindowButton { x: parent.width - 176px; y: 6px; kind: 3; description: "帮助菜单"; clicked => { helpMenu.show(); } }
        WindowButton { x: parent.width - 132px; y: 6px; kind: 0; description: "最小化窗口"; clicked => { root.minimized = true; } }
        WindowButton { x: parent.width - 88px; y: 6px; kind: 1; restored: root.maximized; description: root.maximized ? "还原窗口" : "最大化窗口"; clicked => { root.maximized = !root.maximized; } }
        closeWindow := WindowButton { x: parent.width - 44px; y: 6px; kind: 2; description: "关闭窗口"; clicked => { root.close(); } }
        Rectangle { x: 0px; y: 43px; width: parent.width; height: 1px; background: #e8ebf2; }
    }
    Rectangle {
        x: 0px; y: root.titlebar-height; width: parent.width; height: 64px; background: #ffffff;
        HorizontalLayout {
            x: 24px; y: 14px; width: parent.width - 48px; height: 36px; spacing: 12px;
            fileButtons := HorizontalLayout {
                spacing: 8px; horizontal-stretch: 0;
                newWorkspace := ActionButton { min-width: 88px; label: "新建"; icon: @image-url("../assets/icons/new.svg"); font-size: 13px; shortcut: root.native-chrome ? "⌘N" : "Ctrl+N"; enabled: !root.busy && !root.text-composing; clicked => { root.new-workspace(); } }
                ActionButton { min-width: 108px; label: "导入图片"; icon: @image-url("../assets/icons/image.svg"); font-size: 13px; shortcut: root.native-chrome ? "⌘O" : "Ctrl+O"; enabled: !root.busy && !root.text-composing; clicked => { root.import-image(); } }
            }
            Rectangle { width: 1px; height: 24px; y: 6px; background: #e9ecf1; }
            historyButtons := HorizontalLayout {
                spacing: 8px; horizontal-stretch: 0;
                ActionButton { width: 36px; label: "撤销"; icon: @image-url("../assets/icons/undo.svg"); icon-only: true; quiet: true; shortcut: root.native-chrome ? "⌘Z" : "Ctrl+Z"; enabled: root.can-undo && !root.busy && !root.text-composing; clicked => { root.undo(); } }
                ActionButton { width: 36px; label: "重做"; icon: @image-url("../assets/icons/redo.svg"); icon-only: true; quiet: true; shortcut: root.native-chrome ? "⇧⌘Z" : "Ctrl+Shift+Z / Ctrl+Y"; enabled: root.can-redo && !root.busy && !root.text-composing; clicked => { root.redo(); } }
            }
            Rectangle { min-width: 0px; horizontal-stretch: 1; }
            if root.native-chrome : WindowButton { kind: 3; description: "更多菜单"; clicked => { helpMenu.show(); } }
        }
        Rectangle { x: 0px; y: 63px; width: parent.width; height: 1px; background: #e3e7ed; }
    }

    body := Rectangle {
        y: root.titlebar-height + 64px;
        width: parent.width;
        height: parent.height - self.y;
        background: #f1f3f6;

        // A deliberately narrow tool rail; no editing controls overlap the image.
        Rectangle {
            x: 0px; y: 0px;
            width: 72px;
            height: parent.height;
            background: #ffffff;
            ToolButton {
                x: 12px;
                y: 16px;
                icon: @image-url("../assets/icons/select.svg");
                label: "选择"; shortcut: "V";
                active-state: root.tool == 0;
                enabled: root.loaded && !root.busy && !root.text-composing;
                clicked => { root.choose-tool(0); }
            }
            ToolButton {
                x: 12px;
                y: 91px;
                icon: @image-url("../assets/icons/point.svg");
                label: "点批注"; shortcut: "P";
                active-state: root.tool == 1;
                enabled: root.loaded && !root.busy && !root.text-composing;
                clicked => { root.choose-tool(1); }
            }
            ToolButton {
                x: 12px;
                y: 166px;
                icon: @image-url("../assets/icons/pan.svg");
                label: "平移"; shortcut: "H";
                active-state: root.tool == 2;
                enabled: root.loaded && !root.busy && !root.text-composing;
                clicked => { root.choose-tool(2); }
            }
            Rectangle { x: parent.width - 1px; width: 1px; height: parent.height; background: #e3e7ed; }
        }

        workspace := Rectangle {
            x: 72px;
            width: parent.width - 402px;
            height: parent.height;
            background: #eff1f5;
            Rectangle {
                x: 0px; y: 0px;
                height: 46px;
                width: parent.width;
                background: #f8f9fb;
                Text {
                    x: 22px;
                    y: 14px;
                    width: 86px;
                    height: 19px;
                    text: "预览画布";
                    color: #596476;
                    font-size: 12px;
                    font-weight: 600;
                }
                Text {
                    x: 110px;
                    y: 15px;
                    width: parent.width - 132px;
                    height: 18px;
                    visible: root.busy;
                    text: root.status-text;
                    color: #98a0ac;
                    font-size: 11px;
                    overflow: elide;
                }
                Rectangle { y: parent.height - 1px; width: parent.width; height: 1px; background: #e6e9ef; }
            }

            // Canvas geometry comes from Rust; floating zoom controls render above canvasTouch.
            canvasClip := Rectangle {
                y: 46px;
                width: parent.width;
                height: parent.height - 46px;
                clip: true;
                background: #eff1f5;

                if root.loaded : Rectangle {
                    x: root.canvas-x * 1px - 1px;
                    y: root.canvas-y * 1px - 1px;
                    width: root.canvas-w * 1px + 2px;
                    height: root.canvas-h * 1px + 2px;
                    background: #ffffff;
                    border-width: 1px;
                    border-color: #d6dce5;
                }
                if root.loaded : Image {
                    x: root.canvas-x * 1px;
                    y: root.canvas-y * 1px;
                    width: root.canvas-w * 1px;
                    height: root.canvas-h * 1px;
                    source: root.source-image;
                    image-fit: fill;
                }

                // All removed sources are covered before rendering destination blocks.
                for mark in root.marks : Rectangle {
                    visible: mark.is-block && !mark.is-point;
                    x: (root.canvas-x + mark.source-x * root.canvas-w / max(1, root.source-image.width)) * 1px;
                    y: (root.canvas-y + mark.source-y * root.canvas-h / max(1, root.source-image.height)) * 1px;
                    width: mark.source-w * root.canvas-w / max(1, root.source-image.width) * 1px;
                    height: mark.source-h * root.canvas-h / max(1, root.source-image.height) * 1px;
                    background: #e5e6eb;
                    border-color: #c8ced8;
                    border-width: 1px;
                }

                for mark in root.marks : Rectangle {
                    x: mark.x * 1px;
                    y: mark.y * 1px;
                    width: mark.is-point ? 0px : mark.w * 1px;
                    height: mark.is-point ? 0px : mark.h * 1px;
                    background: transparent;

                    if !mark.is-point : Rectangle {
                        width: parent.width;
                        height: parent.height;
                        background: mark.is-block ? #fefefe : (mark.selected ? #d94b4010 : #d94b4006);
                        border-width: mark.selected ? 2px : 1px;
                        border-color: #dc5147;
                    }
                    // Clip coordinates are pixels in source-image (the Rust-supplied preview image).
                    // Slint 1.18.1 defines all four source-clip-* properties as integers.
                    // Border and pin are separate and intentionally have no resize handles.
                    if mark.is-block && !mark.is-point : Image {
                        x: 2px;
                        y: 2px;
                        width: parent.width > 4px ? parent.width - 4px : 0px;
                        height: parent.height > 4px ? parent.height - 4px : 0px;
                        source: root.source-image;
                        source-clip-x: round(mark.source-x);
                        source-clip-y: round(mark.source-y);
                        source-clip-width: round(mark.source-w);
                        source-clip-height: round(mark.source-h);
                        image-fit: fill;
                    }
                    Rectangle {
                        x: -13px;
                        y: -13px;
                        width: 26px;
                        height: 26px;
                        border-radius: 13px;
                        border-width: 2px;
                        border-color: #ffffff;
                        background: mark.selected ? #be352e : #dc5147;
                        Text {
                            width: parent.width;
                            height: parent.height;
                            text: mark.number;
                            color: #ffffff;
                            font-size: 12px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
                if root.hover-visible && !root.busy : Image {
                    x: root.hover-x * 1px;
                    y: root.hover-y * 1px;
                    width: root.hover-w * 1px;
                    height: root.hover-h * 1px;
                    source: root.hover-image;
                    image-fit: fill;
                }
                if root.preview-visible : Rectangle {
                    x: root.preview-x * 1px;
                    y: root.preview-y * 1px;
                    width: root.preview-w * 1px;
                    height: root.preview-h * 1px;
                    border-width: 1px;
                    border-color: #d94b40;
                    background: #d94b4014;
                }

                canvasKeys := FocusScope {
                    enabled: !root.confirm-visible;
                    KeyBinding { keys: @keys(Control + V); enabled: !root.busy && !root.text-composing; activated => { root.paste-image(); } }
                    KeyBinding { keys: @keys(V); activated => { root.choose-tool(0); } }
                    KeyBinding { keys: @keys(P); activated => { root.choose-tool(1); } }
                    KeyBinding { keys: @keys(H); activated => { root.choose-tool(2); } }
                    KeyBinding { keys: @keys(F); activated => { root.fit-view(); } }
                    key-pressed(event) => {
                        root.shift-held = event.modifiers.shift;
                        if event.text == " " { root.space-held = true; return accept; }
                        if event.text == Key.Escape { root.canvas-command("cancel"); return accept; }
                        if event.text == Key.Delete || event.text == Key.Backspace { root.canvas-command("delete"); return accept; }
                        if event.text == Key.LeftArrow { root.canvas-command(event.modifiers.shift ? "left-fast" : "left"); return accept; }
                        if event.text == Key.RightArrow { root.canvas-command(event.modifiers.shift ? "right-fast" : "right"); return accept; }
                        if event.text == Key.UpArrow { root.canvas-command(event.modifiers.shift ? "up-fast" : "up"); return accept; }
                        if event.text == Key.DownArrow { root.canvas-command(event.modifiers.shift ? "down-fast" : "down"); return accept; }
                        return reject;
                    }
                    key-released(event) => {
                        root.shift-held = event.modifiers.shift;
                        if event.text == " " { root.space-held = false; return accept; }
                        return reject;
                    }
                    canvasTouch := TouchArea {
                        enabled: root.loaded && !root.busy && !root.text-composing;
                        changed has-hover => { if !self.has-hover { root.canvas-command("leave"); } }
                        pointer-event(event) => {
                            if event.kind == PointerEventKind.down {
                                canvasKeys.focus();
                                root.canvas-press(self.mouse-x / 1px, self.mouse-y / 1px,
                                    event.button == PointerEventButton.left ? 0 : (event.button == PointerEventButton.right ? 1 : 2));
                            } else if event.kind == PointerEventKind.up {
                                root.canvas-release(self.mouse-x / 1px, self.mouse-y / 1px);
                            } else if event.kind == PointerEventKind.cancel {
                                root.canvas-command("cancel");
                            } else if event.kind == PointerEventKind.move {
                                // moved() is pressed-only in Slint. Forward all pointer moves
                                // here so unpressed hovering and dragging use one event path.
                                root.canvas-move(self.mouse-x / 1px, self.mouse-y / 1px);
                            }
                        }
                        scroll-event(event) => {
                            root.canvas-wheel(event.delta-x / 1px, event.delta-y / 1px, self.mouse-x / 1px, self.mouse-y / 1px, root.touchpad-scroll);
                            return EventResult.accept;
                        }
                    }
                }

                if !root.loaded : Rectangle {
                    x: (parent.width - 490px) / 2;
                    y: (parent.height - self.height) / 2;
                    width: 490px;
                    height: 306px;
                    background: transparent;
                    Rectangle {
                        x: 207px;
                        y: 16px;
                        width: 76px;
                        height: 66px;
                        border-radius: 11px;
                        border-width: 2px;
                        border-color: #bfc8d5;
                        background: #f9fafc;
                        Rectangle { x: 16px; y: 20px; width: 34px; height: 3px; border-radius: 2px; background: #d1d8e2; }
                        Rectangle { x: 16px; y: 30px; width: 43px; height: 3px; border-radius: 2px; background: #d1d8e2; }
                        Rectangle { x: 16px; y: 40px; width: 25px; height: 3px; border-radius: 2px; background: #d1d8e2; }
                        Rectangle {
                            x: 55px;
                            y: 43px;
                            width: 28px;
                            height: 28px;
                            border-radius: 14px;
                            border-width: 3px;
                            border-color: #edf0f4;
                            background: #d94b40;
                            Text {
                                width: parent.width;
                                height: parent.height;
                                text: "1";
                                color: #ffffff;
                                font-size: 12px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                    Text {
                        y: 113px;
                        width: parent.width;
                        height: 42px;
                        text: "把修改意见，放回画面。";
                        color: #354054;
                        font-size: 28px;
                        font-weight: 700;
                        horizontal-alignment: center;
                    }
                    Text {
                        y: 167px;
                        width: parent.width;
                        height: 48px;
                        text: "拖动选择画面区域，直接写下批注。\n也可以标记一个点，让修改意见更准确。";
                        color: #8791a1;
                        font-size: 13px;
                        horizontal-alignment: center;
                    }
                    ActionButton {
                        x: 55px;
                        y: 241px;
                        width: 132px;
                        height: 40px;
                        label: "导入图片"; icon: @image-url("../assets/icons/image.svg");
                        primary: true;
                        enabled: !root.busy && !root.text-composing;
                        clicked => { root.import-image(); }
                    }
                    ActionButton {
                        x: 199px;
                        y: 241px;
                        width: 102px;
                        height: 40px;
                        label: "粘贴图片";
                        enabled: !root.busy && !root.text-composing;
                        clicked => { root.paste-image(); }
                    }
                    ActionButton {
                        x: 313px;
                        y: 241px;
                        width: 122px;
                        height: 40px;
                        label: "打开示例";
                        enabled: !root.busy && !root.text-composing;
                        clicked => { root.load-example(); }
                    }
                }

                // Controls and their hit region stop click/scroll penetration to the canvas.
                zoomControls := Rectangle {
                    x: parent.width - self.width - 48px;
                    y: parent.height - self.height - 24px;
                    width: 76px; height: 38px;
                    visible: root.loaded;
                    border-radius: 9px;
                    border-width: 1px; border-color: #dce2eb; background: #ffffff;
                    TouchArea {
                        enabled: root.loaded;
                        scroll-event(event) => { return accept; }
                    }
                    ActionButton {
                        x: 4px; y: 4px; width: 32px; height: 30px; label: "缩小"; icon: @image-url("../assets/icons/minus.svg"); icon-only: true; quiet: true;
                        enabled: root.loaded && !root.busy && !root.text-composing;
                        clicked => { root.zoom-by(0.8); }
                    }
                    zoomPlus := ActionButton {
                        x: 40px; y: 4px; width: 32px; height: 30px; label: "放大"; icon: @image-url("../assets/icons/new.svg"); icon-only: true; quiet: true;
                        enabled: root.loaded && !root.busy && !root.text-composing;
                        clicked => { root.zoom-by(1.25); }
                    }
                }
                if root.loaded && root.can-reset-view : resetView := ActionButton {
                    x: zoomControls.x - 42px; y: zoomControls.y;
                    width: 38px; height: 38px; border-radius: 19px;
                    label: "恢复初始视图"; shortcut: "F"; icon: @image-url("../assets/icons/reset-view.svg"); icon-only: true;
                    blocks-scroll: true;
                    enabled: !root.busy && !root.text-composing;
                    clicked => { root.fit-view(); }
                }

                if root.busy : Rectangle {
                    width: parent.width;
                    height: parent.height;
                    background: #edf0f4b8;
                    TouchArea { }
                    Rectangle {
                        x: (parent.width - 168px) / 2;
                        y: (parent.height - 56px) / 2;
                        width: 168px;
                        height: 56px;
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: #dfe4eb;
                        background: #ffffff;
                        Text {
                            width: parent.width;
                            height: parent.height;
                            text: "正在处理，请稍候…";
                            color: #667185;
                            font-size: 13px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // Right panel stays exactly 330 logical pixels wide.
        sidebar := Rectangle {
            x: parent.width - 330px;
            width: 330px;
            height: parent.height;
            background: #ffffff;
            Rectangle { x: 0px; y: 0px; width: 1px; height: parent.height; background: #e0e5ec; }
            Text {
                x: 21px;
                y: 20px;
                width: 48px;
                height: 28px;
                text: "批注";
                color: #2d384a;
                font-size: 20px;
                font-weight: 700;
            }
            Rectangle {
                x: 75px;
                y: 23px;
                width: root.note-count >= 1000 ? 44px : root.note-count >= 100 ? 36px : 30px;
                height: 23px;
                border-radius: 12px;
                background: #f0f2f6;
                Text {
                    width: parent.width;
                    height: parent.height;
                    text: root.note-count;
                    color: #7b8595;
                    font-size: 11px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            clearFeedback := ActionButton {
                x: 222px; y: 18px; width: 88px; height: 34px;
                label: "清空当前";
                quiet: true;
                destructive: true;
                enabled: root.loaded && root.note-count > 0 && !root.busy && !root.text-composing;
                clicked => { root.clear-feedback(); }
            }
            ActionButton {
                x: 20px;
                y: 60px;
                width: 290px;
                height: 34px;
                label: "添加整体意见"; icon: @image-url("../assets/icons/new.svg");
                shortcut: root.note-count >= 1000 ? "已达到 1000 条批注上限" : "";
                enabled: root.loaded && root.note-count < 1000 && !root.busy && !root.text-composing;
                clicked => { root.add-global(); }
            }
            Rectangle { x: 20px; y: 108px; width: 290px; height: 1px; background: #edf0f4; }

            noteScroll := ScrollView {
                x: 20px;
                y: 120px;
                width: 290px;
                height: parent.height - 196px;
                content-width: self.visible-width;
                noteList := VerticalLayout {
                    spacing: 8px;
                    padding-top: 12px;
                    padding-bottom: 12px;
                    for note[index] in root.notes : noteCard := Rectangle {
                        property <bool> editor-focused: false;
                        property <length> layout-top: noteList.y + self.y;
                        property <length> layout-bottom: self.layout-top + self.height;
                        property <length> list-content-height: noteScroll.content-height;
                        property <NoteViewState> view-state: {
                            token: note.id, index: index,
                            top: self.layout-top, bottom: self.layout-bottom,
                            focused: self.editor-focused,
                            active: note.selected && note.id == root.active-note-token,
                            composing: self.editor-composing,
                            header-x: header.absolute-position.x + header.width / 2,
                            header-y: header.absolute-position.y + header.height / 2,
                            delete-x: deleteNote.absolute-position.x + deleteNote.width / 2,
                            delete-y: deleteNote.absolute-position.y + deleteNote.height / 2,
                            editor-x: self.absolute-position.x + self.width / 2,
                            editor-y: self.absolute-position.y + 96px,
                        };
                        property <int> reveal-request: root.note-reveal-request;

                        function publish-state() {
                            if self.view-state.active { root.active-note-state = self.view-state; }
                        }
                        function reveal-pending() {
                            if self.view-state.active && root.note-reveal-token == note.id
                                && root.note-reveal-request != root.note-reveal-applied
                                && !root.confirm-visible && self.y >= 0px {
                                root.reveal-note-bounds(self.view-state.top, self.view-state.bottom);
                                root.note-reveal-applied = root.note-reveal-request;
                            }
                        }
                        // 大批量创建行时，列表高度与卡片位置可能分多次完成布局。
                        // 只在这些几何值改变时修正滚动；普通重绘和手动滚动不抢焦点。
                        function reveal-after-layout() {
                            if self.view-state.active && root.note-reveal-token == note.id && !root.confirm-visible {
                                root.reveal-note-bounds(self.layout-top, self.layout-bottom);
                            }
                            self.reveal-pending();
                        }
                        changed layout-top => { self.reveal-after-layout(); }
                        changed layout-bottom => { self.reveal-after-layout(); }
                        changed list-content-height => { self.reveal-after-layout(); }
                        init => { self.publish-state(); self.reveal-pending(); }
                        changed view-state => { self.publish-state(); self.reveal-pending(); }
                        changed reveal-request => { self.reveal-pending(); }
                        property <bool> editor-composing: false;
                        property <length> number-width: note.number >= 1000 ? 40px : note.number >= 100 ? 32px : 23px;
                        height: note.selected ? 88px + note.editor-height * 1px : 48px;
                        border-radius: 9px; border-width: 1px;
                        border-color: note.selected ? #cbd5ff : header.hovered ? #cbd3df : #e5e9f0;
                        background: note.selected ? #f5f7ff : header.hovered ? #f8f9fc : #ffffff;
                        animate background, border-color { duration: 120ms; }
                        header := FocusScope {
                            x: 1px; y: 1px; width: parent.width - 41px; height: 46px;
                            enabled: !root.busy && !root.confirm-visible && !root.text-composing;
                            out property <bool> hovered: headerHit.has-hover;
                            accessible-role: button;
                            accessible-id: "annotation-" + note.stable-id;
                            accessible-label: "批注 " + note.number + "，" + note.summary;
                            accessible-enabled: self.enabled;
                            accessible-expandable: true;
                            accessible-expanded: note.selected;
                            accessible-action-default => { root.select-note(note.id); }
                            key-pressed(event) => {
                                if event.text == Key.Return || event.text == " " { root.select-note(note.id); return accept; }
                                return reject;
                            }
                            changed has-focus => { if self.has-focus { root.reveal-note-bounds(noteCard.view-state.top, noteCard.view-state.top + 48px); } }
                            Rectangle {
                                width: parent.width; height: parent.height; border-radius: 8px;
                                background: transparent; border-width: header.has-focus ? 2px : 0px; border-color: #7085eb;
                            }
                            headerHit := TouchArea { enabled: parent.enabled; clicked => { root.select-note(note.id); } }
                        }
                        Rectangle {
                            x: 12px; y: 12px; width: noteCard.number-width; height: 23px;
                            border-radius: 12px; background: #dc2b39;
                            Text { text: note.number; width: parent.width; height: parent.height; color: #ffffff; font-size: 11px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                        }
                        Text {
                            x: 21px + noteCard.number-width; y: 14px;
                            width: parent.width - self.x - (note.selected ? 115px : 76px); height: 20px;
                            text: note.selected ? note.kind-label : note.summary;
                            color: #354155; font-size: 12px; font-weight: 600; overflow: elide;
                        }
                        if note.selected : Text {
                            x: parent.width - 113px; y: 16px; width: 40px; height: 17px;
                            text: "编辑中"; font-size: 10px; color: #7184db; horizontal-alignment: right;
                        }
                        Image {
                            x: parent.width - 67px; y: 17px; width: 14px; height: 14px;
                            source: note.selected ? @image-url("../assets/icons/chevron-down.svg") : @image-url("../assets/icons/chevron.svg"); colorize: #697487;
                        }
                        deleteNote := ActionButton {
                            x: parent.width - 39px; y: 8px; width: 32px; height: 32px;
                            label: "删除批注 " + note.number; icon: @image-url("../assets/icons/trash.svg"); icon-size: 15px;
                            icon-only: true; quiet: true; destructive: true; enabled: !root.busy && !root.confirm-visible && !root.text-composing;
                            clicked => { root.remove-note(note.id); }
                        }
                        if note.selected : Text {
                            x: 12px; y: 48px; width: parent.width - 24px; height: 17px;
                            text: note.detail; color: #8791a1; font-size: 11px; overflow: elide;
                        }
                        if note.selected : editor := NoteEditor {
                            x: 12px; y: 76px; width: parent.width - 24px; height: note.editor-height * 1px;
                            text: note.text; enabled: !root.busy && !root.confirm-visible;
                            property <bool> was-focused: false;
                            property <int> focus-request: root.note-reveal-applied;
                            changed focus-request => {
                                if note.id == root.active-note-token && note.id == root.note-reveal-token && !root.confirm-visible && !root.busy { self.focus(); }
                            }
                            init => {
                                noteCard.editor-focused = self.has-focus;
                                if !root.confirm-visible { self.focus(); }
                            }
                            changed has-focus => {
                                noteCard.editor-focused = self.has-focus;
                                if self.has-focus { self.was-focused = true; }
                                else if self.was-focused && !root.confirm-visible { root.note-edit-finished(note.id); }
                            }
                            changed composing => { noteCard.editor-composing = self.composing; }
                            edited(text) => { root.note-edited(note.id, text); }
                            key-pressed(event) => {
                                if root.confirm-visible { return accept; }
                                if event.text == Key.Escape { root.canvas-command("cancel-text"); canvasKeys.focus(); return accept; }
                                if event.modifiers.control && event.text == Key.Return {
                                    root.canvas-command("finish-text");
                                    if !root.confirm-visible { canvasKeys.focus(); }
                                    return accept;
                                }
                                return reject;
                            }
                        }

                    }
                }
            }
            if root.note-count == 0 : Rectangle {
                x: 26px;
                y: noteScroll.y + 24px;
                width: 278px;
                height: 164px;
                background: transparent;
                Text {
                    y: 3px;
                    width: parent.width;
                    height: 34px;
                    text: "＋";
                    color: #cad1dc;
                    font-size: 31px;
                    horizontal-alignment: center;
                }
                Text {
                    y: 52px;
                    width: parent.width;
                    height: 24px;
                    text: "还没有批注";
                    color: #8b95a4;
                    font-size: 13px;
                    horizontal-alignment: center;
                }
                Text {
                    y: 83px;
                    width: parent.width;
                    height: 43px;
                    text: "在画面中拖动框选或添加标记，\n你的修改意见会出现在这里。";
                    color: #a8afba;
                    font-size: 11px;
                    horizontal-alignment: center;
                }
            }
            Rectangle {
                x: 1px;
                y: parent.height - 64px;
                width: parent.width - 1px;
                height: 64px;
                background: #ffffff;
                copyFeedback := ActionButton {
                    x: 20px;
                    y: 14px;
                    width: 290px;
                    height: 36px;
                    label: root.copy-complete ? "已复制" : "复制反馈说明";
                    icon: @image-url("../assets/icons/copy.svg");
                    accessible-description: "复制本机原图路径和修改意见；跨设备需另附原图。";
                    enabled: root.loaded && root.note-count > 0 && !root.busy && !root.text-composing;
                    clicked => { root.copy-feedback(); }
                }
                Rectangle { x: 0px; y: 0px; width: parent.width; height: 1px; background: #edf0f4; }
                if (copyFeedback.hovered || copyFeedback.focused) && !root.confirm-visible && !root.toast-visible : Rectangle {
                    x: 20px; y: -58px; width: 290px; height: 64px;
                    border-radius: 8px; border-width: 1px; border-color: #dfe3ed;
                    background: #ffffff;
                    Text {
                        x: 12px; y: 11px; width: parent.width - 24px; height: 42px;
                        text: "复制原图路径和精简修改建议。\n跨设备请另附原图。";
                        color: #687386; font-size: 12px; wrap: word-wrap;
                    }
                }
            }
        }
    }

    // Non-modal, explicit copy acknowledgement; no permanent refresh timer.
    toast := Rectangle {
        visible: root.toast-visible;
        x: copyFeedback.absolute-position.x;
        y: copyFeedback.absolute-position.y - self.height - 12px;
        width: copyFeedback.width;
        height: 88px;
        border-radius: 11px;
        border-width: 1px;
        border-color: root.toast-success ? #b8d9c7 : #edc0c7;
        background: #ffffff;
        Rectangle { x: 16px; y: 17px; width: 28px; height: 28px; border-radius: 14px; background: root.toast-success ? #e4f3ea : #fbe9ec;
            if root.toast-success : Path { x: 8px; y: 9px; width: 12px; height: 10px; commands: "M 0 5 L 4 9 L 12 0"; stroke: #258557; stroke-width: 1.8px; fill: transparent; }
            if !root.toast-success : Text { x: 0px; y: 0px; width: parent.width; height: parent.height; text: "!"; color: #c34759; font-size: 16px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
        }
        Text { x: 55px; y: 14px; width: parent.width - 92px; height: 24px; text: root.toast-title; color: #29384b; font-size: 14px; font-weight: 600; }
        Text { x: 55px; y: 40px; width: parent.width - 75px; height: 35px; text: root.toast-message; color: #7b8595; font-size: 11px; wrap: word-wrap; overflow: elide; }
        ActionButton { x: parent.width - 38px; y: 7px; width: 32px; height: 32px;
            label: "关闭提示"; icon: @image-url("../assets/icons/close.svg"); icon-size: 15px; icon-only: true; quiet: true;
            clicked => { root.dismiss-toast(); }
        }
    }
    Rectangle { x: 0px; y: 0px; width: parent.width; height: parent.height; background: transparent; border-color: #dfe3eb; border-width: 1px; }

    // Keep this layer and its FocusScope instantiated: visibility and enabled gate
    // all input while preserving stable IDs for focus transitions and UI tests.
    confirmOverlay := Rectangle {
        x: 0px; y: 0px;
        width: root.width; height: root.height;
        visible: root.confirm-visible;
        background: #17213c77;
        TouchArea {
            enabled: root.confirm-visible;
            pointer-event(event) => { if event.kind == PointerEventKind.down { confirmKeys.focus(); } }
            scroll-event(event) => { return accept; }
        }
        confirmKeys := FocusScope {
            x: 0px; y: 0px; width: parent.width; height: parent.height;
            enabled: root.confirm-visible;
            capture-key-pressed(event) => {
                if event.text == Key.Escape { root.confirm-response(0); return accept; }
                if event.text == Key.Return {
                    root.confirm-response(root.confirm-choice == 0 && root.confirm-show-cancel ? 0 : 2);
                    return accept;
                }
                if event.text == Key.Tab || event.text == Key.Backtab || event.text == Key.LeftArrow || event.text == Key.RightArrow {
                    root.confirm-choice = root.confirm-show-cancel && root.confirm-choice == 2 ? 0 : 2;
                    return accept;
                }
                // Do not leak Delete, Space, letters, or modified shortcuts to the canvas.
                return accept;
            }
            capture-key-released(event) => { return accept; }
            confirmCard := Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 520px;
                height: root.confirm-name == "" ? 292px : 326px;
                background: transparent;
                Rectangle { x: -2px; y: 9px; width: parent.width + 4px; height: parent.height + 4px; border-radius: 19px; background: #101b3b15; }
                Rectangle { x: 0px; y: 0px; width: parent.width; height: parent.height; border-radius: 17px; border-width: 1px; border-color: #e3e6f0; background: #ffffff; }
                accessible-role: groupbox;
                accessible-label: root.confirm-title;

                // Confirmation and notice symbols, built from vectors rather than font glyphs.
                Rectangle {
                    x: 28px; y: 28px; width: 52px; height: 52px;
                    border-radius: 15px; background: root.confirm-destructive ? #fff0f2 : #eff0ff;
                    if root.confirm-destructive : Path { x: 13px; y: 13px; width: 26px; height: 25px; commands: "M 13 1 L 25 23 H 1 Z M 13 8 V 15 M 13 19 V 20"; stroke: #d45a6a; stroke-width: 1.8px; fill: transparent; }
                    if !root.confirm-destructive : Rectangle {
                        x: 14px; y: 14px; width: 24px; height: 24px; border-radius: 12px; border-width: 1.7px; border-color: #5b62d5; background: transparent;
                        Rectangle { x: 10px; y: 6px; width: 3px; height: 3px; border-radius: 1.5px; background: #5b62d5; }
                        Rectangle { x: 10.5px; y: 11px; width: 2px; height: 7px; border-radius: 1px; background: #5b62d5; }
                    }
                    Rectangle { x: 38px; y: 3px; width: 10px; height: 10px; border-radius: 5px; border-width: 2px; border-color: #ffffff; background: #ff8074; }
                }
                Text { x: 97px; y: 30px; width: 352px; height: 30px; text: root.confirm-title == "" ? "确认操作？" : root.confirm-title; color: #2a354b; font-size: 20px; font-weight: 600; overflow: elide; }
                ScrollView {
                    x: 97px; y: 67px; width: 365px; height: root.confirm-name == "" ? 91px : 42px;
                    content-width: self.width - 14px;
                    VerticalLayout {
                        Text { text: root.confirm-description; color: #8790a2; font-size: 12px; wrap: word-wrap; }
                    }
                }
                Rectangle {
                    x: parent.width - 45px; y: 16px; width: 29px; height: 29px;
                    border-radius: 8px; background: confirmCloseHit.has-hover ? #f1f3f8 : transparent;
                    Path { x: 10px; y: 10px; width: 9px; height: 9px; commands: "M 0 0 L 9 9 M 9 0 L 0 9"; stroke: #8c95a7; stroke-width: 1.5px; fill: transparent; }
                    confirmCloseHit := TouchArea {
                        enabled: root.confirm-visible;
                        clicked => { confirmKeys.focus(); root.confirm-response(0); }
                    }
                }
                Rectangle {
                    x: 28px; y: 124px; width: parent.width - 56px; height: 64px;
                    visible: root.confirm-name != "";
                    border-radius: 10px; border-width: 1px; border-color: #e9ebf3; background: #f7f8fc;
                    Path { x: 17px; y: 18px; width: 21px; height: 27px; commands: "M 2 1 H 14 L 21 8 V 26 H 2 Z M 14 1 V 8 H 21 M 7 14 H 16 M 7 19 H 16"; stroke: #959eb2; stroke-width: 1.3px; fill: transparent; }
                    Text { x: 54px; y: 12px; width: parent.width - 71px; height: 22px; text: root.confirm-name == "" ? "当前图片" : root.confirm-name; color: #4b5770; font-size: 13px; font-weight: 500; overflow: elide; }
                    Text { x: 54px; y: 36px; width: parent.width - 71px; height: 17px; text: "当前操作对象"; color: #99a2b4; font-size: 10px; }
                }
                Text {
                    x: 29px; y: root.confirm-name == "" ? 170px : 204px; width: parent.width - 58px; height: 24px;
                    visible: root.confirm-footnote != "";
                    text: root.confirm-footnote;
                    color: #929bab; font-size: 11px;
                }
                Rectangle { x: 28px; y: parent.height - 86px; width: parent.width - 56px; height: 1px; background: #eef0f5; }
                Text { x: 29px; y: parent.height - 52px; width: 96px; height: 18px; text: root.confirm-show-cancel ? "Esc 取消" : "Enter 继续"; color: #a8afbd; font-size: 10px; }
                confirmCancel := ActionButton {
                    x: parent.width - 276px; y: parent.height - 66px; width: 84px; height: 40px;
                    label: root.confirm-cancel-label;
                    visible: root.confirm-show-cancel;
                    enabled: root.confirm-visible && root.confirm-show-cancel;
                    focus-ring: confirmKeys.has-focus && root.confirm-choice == 0;
                    clicked => { root.confirm-choice = 0; confirmKeys.focus(); root.confirm-response(0); }
                }
                confirmPrimary := ActionButton {
                    x: parent.width - 182px; y: parent.height - 66px; width: 154px; height: 40px;
                    label: root.confirm-primary-label;
                    primary: true;
                    destructive: root.confirm-destructive;
                    enabled: root.confirm-visible;
                    focus-ring: confirmKeys.has-focus && root.confirm-choice == 2;
                    clicked => { root.confirm-choice = 2; confirmKeys.focus(); root.confirm-response(2); }
                }
            }
        }
    }
    }
}
